<Window x:Class="WowDBEditor.App.Dialogs.SqlExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出 MySQL SQL 文件" Width="580" Height="330" Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择导出方式" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <RadioButton x:Name="IdempotentRadio" Grid.Row="1" IsChecked="True" GroupName="Mode"
                     Content="幂等增量（推荐）"/>
        <TextBlock Grid.Row="2" Margin="24,4,0,10" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource MutedForeground}"
                   Text="CREATE TABLE IF NOT EXISTS + INSERT ... ON DUPLICATE KEY UPDATE。不会删表，脚本可重复执行，重复导入不会产生重复行。"/>

        <RadioButton x:Name="RebuildRadio" Grid.Row="3" GroupName="Mode"
                     Content="完整重建"/>
        <TextBlock Grid.Row="4" Margin="24,4,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource MutedForeground}"
                   Text="DROP TABLE IF EXISTS + CREATE TABLE + 全量 INSERT。适合首次交付给数据库管理员，重跑结果同样一致。"/>

        <TextBlock Grid.Row="6" VerticalAlignment="Bottom" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource MutedForeground}"
                   Text="提示：同一个脚本重复执行不会改变结果；导入回本工具时按主键 ID 合并。"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="下一步：选择文件" Width="140" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="90" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

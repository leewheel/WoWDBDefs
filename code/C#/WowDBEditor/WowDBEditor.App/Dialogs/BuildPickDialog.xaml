<Window x:Class="WowDBEditor.App.Dialogs.BuildPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择定义版本" Width="620" Height="530" Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="无法自动匹配该文件的定义版本，请手动选择对应的客户端版本："/>

        <ListBox x:Name="ChoiceList" Grid.Row="1" DisplayMemberPath="Label"
                 MouseDoubleClick="ChoiceList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="ToolTip" Value="{Binding Detail}"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="或直接输入版本号：" Margin="0,0,8,0"/>
            <TextBox x:Name="BuildBox" Grid.Column="1" ToolTip="例如 3.3.5.12340，回车确认"/>
            <TextBlock Grid.Column="2" Margin="10,0,0,0" Foreground="{StaticResource MutedForeground}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Text="填自己的客户端版本，按 DBD 精确匹配"/>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11.5"
                   Foreground="{StaticResource MutedForeground}"
                   Text="「区间」条目表示 DBD 里这段版本共用一个定义，选它等于选区间内任意版本；鼠标停在条目上可看适用范围。"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="90" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="90" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

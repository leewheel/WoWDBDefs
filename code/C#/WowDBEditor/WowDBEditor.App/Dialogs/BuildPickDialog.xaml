<Window x:Class="WowDBEditor.App.Dialogs.BuildPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择定义版本" Width="560" Height="420" Icon="Assets/app.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="无法自动匹配该文件的定义版本，请手动选择对应的客户端版本："/>
        <ListBox x:Name="ChoiceList" Grid.Row="1" DisplayMemberPath="Label"
                 MouseDoubleClick="ChoiceList_MouseDoubleClick"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="90" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="90" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
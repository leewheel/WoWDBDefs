<Window x:Class="WowDBEditor.App.Dialogs.MySqlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MySQL" Width="540" Height="470" Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="主机"/>
            <TextBox x:Name="HostBox" Grid.Column="1"/>
            <TextBlock Grid.Column="2" Text="端口" Margin="10,0,0,0"/>
            <TextBox x:Name="PortBox" Grid.Column="3"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="用户名"/>
            <TextBox x:Name="UserBox" Grid.Column="1"/>
            <TextBlock Grid.Column="2" Text="密码" Margin="10,0,0,0"/>
            <PasswordBox x:Name="PasswordBox" Grid.Column="3"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="数据库"/>
            <TextBox x:Name="DatabaseBox" Grid.Column="1"/>
            <Button x:Name="TestButton" Grid.Column="2" Content="测试连接" Margin="8,0,0,0" Click="Test_Click"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TableLabel" Grid.Column="0" Text="表名"/>
            <TextBox x:Name="TableBox" Grid.Column="1"/>
            <ComboBox x:Name="TableCombo" Grid.Column="1" Visibility="Collapsed" IsEditable="True"/>
            <Button x:Name="RefreshTablesButton" Grid.Column="2" Content="刷新列表" Margin="8,0,0,0"
                    Visibility="Collapsed" Click="RefreshTables_Click"/>
        </Grid>

        <CheckBox x:Name="ReplaceCheck" Grid.Row="5" Content="替换已存在的表（先删除再重建）" Margin="70,0,0,8"/>

        <TextBlock x:Name="HintText" Grid.Row="6" Foreground="{StaticResource MutedForeground}"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="7" VerticalAlignment="Bottom">
            <ProgressBar x:Name="Progress" Margin="0,0,0,6" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource MutedForeground}"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ActionButton" Content="导出" Width="110" Margin="0,0,8,0" Click="Action_Click"/>
            <Button x:Name="CloseButton" Content="关闭" Width="90" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
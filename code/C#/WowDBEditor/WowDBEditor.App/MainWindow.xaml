<Window x:Class="WowDBEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WowDBEditor" Width="1280" Height="800" Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="打开…" Command="ApplicationCommands.Open" InputGestureText="Ctrl+O"/>
                <MenuItem Header="保存" Command="ApplicationCommands.Save" InputGestureText="Ctrl+S"/>
                <MenuItem Header="另存为…" Command="ApplicationCommands.SaveAs" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="退出" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="MySQL(_M)">
                <MenuItem x:Name="MenuExportMySql" Header="导出到 MySQL…" Click="ExportMySql_Click"/>
                <MenuItem x:Name="MenuImportMySql" Header="从 MySQL 导入…" Click="ImportMySql_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuExportSql" Header="导出 SQL 文件…" Click="ExportSqlFile_Click"/>
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="设置…" Click="Settings_Click"/>
                <MenuItem Header="重新加载定义缓存" Click="ReloadDefinitions_Click"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource PanelBackground}">
            <ToolBar>
                <Button Content="打开" Command="ApplicationCommands.Open"/>
                <Button Content="保存" Command="ApplicationCommands.Save"/>
                <Button Content="另存为" Command="ApplicationCommands.SaveAs"/>
                <Separator/>
                <Button x:Name="BtnAddRow" Content="添加行" Click="AddRow_Click"/>
                <Button x:Name="BtnDeleteRow" Content="删除行" Click="DeleteRows_Click"/>
                <Separator/>
                <Button x:Name="BtnExportMySql" Content="导出 MySQL" Click="ExportMySql_Click"/>
                <Button x:Name="BtnImportMySql" Content="导入 MySQL" Click="ImportMySql_Click"/>
                <Button x:Name="BtnExportSql" Content="SQL 文件" Click="ExportSqlFile_Click"/>
            </ToolBar>
        </ToolBarTray>

        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock x:Name="InfoText" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource MutedForeground}" Text="未打开文件"/>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource WindowBackground}" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="筛选：" Margin="0,0,6,0"/>
                <TextBox x:Name="FilterBox" Width="300" TextChanged="FilterBox_TextChanged"
                         ToolTip="输入 ID 精确匹配；输入文本在所有字符串列中模糊匹配"/>
                <Button Content="清除" Margin="8,0,0,0" Click="ClearFilter_Click"/>
                <TextBlock x:Name="MatchCount" Margin="12,0,0,0" Foreground="{StaticResource MutedForeground}"/>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="DirtyText" Text="" Foreground="{StaticResource Accent}"/>
            </StatusBarItem>
        </StatusBar>

        <DataGrid x:Name="Grid" FrozenColumnCount="1" IsReadOnly="False"
                  CellEditEnding="Grid_CellEditEnding"/>
    </DockPanel>
</Window>